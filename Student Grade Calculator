student_name =input("Enter student name:")

first_number = int(input("Enter first subject marks: "))
second_number = int(input("Enter second subject marks: "))
third_number = int(input("Enter third subject marks: "))

total_marks= first_number + second_number + third_number 
avg_marks= total_marks/3


if avg_marks >=80:
        Grade = "A+"
elif avg_marks >=70:
        Grade = "A"
elif avg_marks >=60:
        Grade = "A-"
elif avg_marks >=50:
        Grade = "B"
elif avg_marks >=40:
        Grade = "C"
else:
        Grade = "F"


print(f"Student Name:{student_name }")
print(f"Total Marks:{total_marks}")
print(f"Average:{avg_marks}")
print(f"Grade:{Grade}")

